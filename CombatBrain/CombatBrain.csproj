<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>CombatBrain</AssemblyName>
    <RootNamespace>CombatBrain</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Win64_Shipping_Client\</OutputPath>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameDir>
    <GameBinDir>$(GameDir)\bin\Win64_Shipping_Client</GameBinDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameBinDir)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameBinDir)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameBinDir)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(GameBinDir)\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameBinDir)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.SaveSystem">
      <HintPath>$(GameBinDir)\TaleWorlds.SaveSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameBinDir)\TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- t73：MCM 可选集成编译期引用。HintPath 指玩家已装 MCM 的模块 dll；
         Private=false(CopyLocal=false) 不把 MCMv5.dll 拷进 CombatBrain 模块，
         靠玩家已装 MCM 提供（SubModule.xml 声明 optional 依赖 + SubModule 懒触碰，没装 MCM 不崩）。 -->
    <Reference Include="MCMv5">
      <HintPath>$(GameDir)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CPS-0：Harmony 只读观测（SetOrderObserver）编译期引用。来源：游戏 Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll
         （用户已装，模块随游戏加载 0Harmony；Private=false 不拷进 CombatBrain 模块）。
         仅诊断观测（Formation 三个 SetOrder Prefix），默认关闭不应用 patch；运行时缺 0Harmony 亦 fail-open 不崩。 -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="SubModule.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>